# Environment variables for devcontainer
# Copy this file to .env and adjust values if needed

# =============================================================================
# Project Identification (REQUIRED)
# =============================================================================
# Unique project name to prevent container/volume/network name conflicts
# when using the same devcontainer setup across multiple projects
# IMPORTANT: This value is REQUIRED. Set it before starting the devcontainer.
PROJECT_NAME=platform-builder

# =============================================================================
# Docker Platform (Optional)
# =============================================================================
# Specify the target platform for Docker container
# - linux/arm64: For Apple Silicon (M1/M2/M3) - Fast, native performance
# - linux/amd64: For Intel/AMD x86_64 - Slower on ARM Mac (emulation via Rosetta)
# Default: linux/arm64
DOCKER_PLATFORM=linux/arm64

# =============================================================================
# User Information
# =============================================================================
# User information (automatically detected in most cases)
# USER is typically set by the shell
# UID and GID can be obtained with: id -u and id -g

# On macOS, you may need to explicitly set these:
# USER=yamazaki
# UID=501
# GID=20

# On Linux, these are usually available by default:
# USER=$(whoami)
# UID=$(id -u)
# GID=$(id -g)

# =============================================================================
# Port Configuration (Optional - to avoid port conflicts)
# =============================================================================
# Uncomment and modify if you need to expose ports and avoid conflicts
# HOST_PORT_8080=8080
# HOST_PORT_3000=3000
